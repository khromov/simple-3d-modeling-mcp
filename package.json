{
  "name": "sketchpad-3d-model-mcp",
  "version": "1.0.0",
  "description": "MCP server that lets Claude and other AI assistants create, preview and export 3D models with OpenSCAD — zero setup (bundled WASM), BOSL2 included",
  "type": "module",
  "bin": {
    "sketchpad-3d-model-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "workspaces": [
    "viewer"
  ],
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean && npm run assets",
    "build": "npm run build:viewer && tsc",
    "build:viewer": "npm run build --workspace viewer",
    "dev": "tsc --watch",
    "dev:viewer": "npm run dev --workspace viewer --",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && npm run check --workspace viewer",
    "prepublishOnly": "npm run build",
    "pretest": "npm run assets && npm run build:viewer",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mcpb": "bash scripts/build-mcpb.sh"
  },
  "keywords": [
    "mcp",
    "openscad",
    "3d-modeling",
    "cad",
    "model-context-protocol",
    "claude",
    "ai",
    "bosl2",
    "3d-printing",
    "stl",
    "3mf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khromov/simple-3d-modeling-mcp.git"
  },
  "homepage": "https://github.com/khromov/simple-3d-modeling-mcp#readme",
  "bugs": {
    "url": "https://github.com/khromov/simple-3d-modeling-mcp/issues"
  },
  "author": "mazzanfar",
  "license": "GPL-2.0",
  "dependencies": {
    "@tmcp/transport-stdio": "^0.5.1",
    "tmcp": "^1.20.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tmcp/transport-in-memory": "^0.1.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "adm-zip": "^0.6.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.13.1 <27"
  },
  "publishConfig": {
    "access": "public"
  }
}
